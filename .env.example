# Copy this to “.env” and update the values below:

# PostgreSQL connection (SQLAlchemy DATABASE_URL)
DATABASE_URL=postgresql://username:password@host:port/dbname

# Environment (development | production)
ENV=development

# Kafka broker address
KAFKA_BROKER=kafka:9092

# Celery & RabbitMQ settings
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_WORKER_SEND_TASK_EVENTS=True
CELERY_TASK_SEND_SENT_EVENT=True

# Python path for imports
PYTHONPATH=/code

# Secret used for HMAC signature verification
WEBHOOK_SECRET=your_webhook_secret_here

# Optional Prometheus settings
# RUN_PROM_METRICS=true
# PROMETHEUS_MULTIPROC_DIR=/tmp/metrics